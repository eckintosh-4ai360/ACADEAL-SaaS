generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String    @id @default(uuid())
  username    String    @unique
  staffId     String    @unique
  staffProfileId String? @unique
  password    String
  name        String
  email       String?   @unique
  phone       String?
  img         String?
  role        AdminRole @default(ADMIN)
  permissions Json? // { recordStudents, editFeeRecords, statement, prepareBill, admissions, paymentList, generateBill, arrearsPDF, schoolFees, receipt, viewDetail, expenses, income, specialFeesOffer, busFee, feedingFee, salary, salaryAdvance, financialReport, message }
  staffProfile Staff?   @relation("AdminStaffProfile", fields: [staffProfileId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum StaffType {
  ADMIN
  TEACHER
}

model Staff {
  id           String     @id @default(uuid())
  staffId      String     @unique
  username     String
  password     String
  name         String
  surname      String?
  email        String?
  phone        String?
  address      String?
  img          String?
  sex          UserSex?
  birthday     DateTime?
  permissions  Json?
  staffType    StaffType
  adminRole    AdminRole?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  admin        Admin?     @relation("AdminStaffProfile")
  teacher      Teacher?   @relation("TeacherStaffProfile")

  @@unique([staffType, username])
  @@index([staffType, name, surname])
  @@index([email])
  @@index([phone])
}

enum LibraryCatalogItemType {
  BOOK
  DIGITAL_RESOURCE
}

enum LibraryCatalogAvailability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

model Student {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  studentId             String                 @unique
  password              String
  name                  String
  surname               String
  otherNames            String?
  email                 String?                @unique
  phone                 String?                @unique
  address               String?
  img                   String?
  bloodType             String?
  sex                   UserSex
  birthday              DateTime
  residencyStatus       String                 @default("DAY")
  house                 String?
  guardianName          String?
  contactNumber         String?
  occupation            String?
  nhisNumber            String?
  admissionDate         DateTime?
  emergencyContact      String?
  nationality           String?
  firstLanguage         String?
  enrollmentDate        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  parentId              String?
  parent                Parent?                @relation(fields: [parentId], references: [id])
  classId               Int
  class                 Class                  @relation(fields: [classId], references: [id])
  gradeId               Int
  grade                 Grade                  @relation(fields: [gradeId], references: [id])
  attendances           Attendance[]
  results               Result[]
  fees                  Fee[]
  feePayments           FeePayment[]
  behaviors             Behavior[]
  medicalInfo           MedicalInfo?
  documents             Document[]
  comments              Comment[]
  studentAnswers        StudentAnswer[]
  examAnswers           StudentExamAnswer[]
  aiQuizAttempts        AiQuizAttempt[]
  savedReportCards      SavedReportCard[]
  reportCardEntries     ReportCardEntry[]
  parentTeacherMeetings ParentTeacherMeeting[]
  excursionPayments     ExcursionPayment[]
  feeCollectionPayments FeeCollectionPayment[]
  libraryBorrows        LibraryBorrow[]
  studentBills          StudentBill[]
}

model Teacher {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  staffId               String                 @unique
  staffProfileId        String?                @unique
  password              String
  name                  String
  surname               String
  email                 String?                @unique
  phone                 String?                @unique
  address               String
  img                   String?
  sex                   UserSex
  birthday              DateTime
  permissions           Json? // { recordStudents, editFeeRecords, statement, prepareBill, admissions, paymentList, generateBill, arrearsPDF, schoolFees, receipt, viewDetail, expenses, income, specialFeesOffer, busFee, feedingFee, salary, salaryAdvance, financialReport, message }
  staffProfile          Staff?                 @relation("TeacherStaffProfile", fields: [staffProfileId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subjects              Subject[]
  lessons               Lesson[]
  classes               Class[]
  subjectAssignments    ClassSubjectTeacher[]
  aiQuestionPacks       AiQuestionPack[]
  parentTeacherMeetings ParentTeacherMeeting[]
  meetingAvailabilities MeetingAvailability[]
  timetableEntries      TimetableEntry[]
}

model Parent {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  parentUserId          String?                @unique
  password              String
  name                  String
  surname               String
  email                 String?                @unique
  phone                 String
  address               String?
  img                   String?
  isProfileComplete     Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  students              Student[]
  parentTeacherMeetings ParentTeacherMeeting[]
}

model Grade {
  id           Int              @id @default(autoincrement())
  level        Int              @unique
  students     Student[]
  classes      Class[]
  syllabi      CourseSyllabus[]
  videoLessons VideoLesson[]
}

model Class {
  id                        Int                   @id @default(autoincrement())
  name                      String                @unique
  capacity                  Int
  supervisorId              String?
  supervisor                Teacher?              @relation(fields: [supervisorId], references: [id])
  gradeId                   Int
  grade                     Grade                 @relation(fields: [gradeId], references: [id])
  lessons                   Lesson[]
  students                  Student[]
  subjectTeacherAssignments ClassSubjectTeacher[]
  excursionCampaigns        ExcursionCampaign[]
  feeCollectionCampaigns    FeeCollectionCampaign[]
  events                    Event[]
  announcements             Announcement[]
  notifications             Notification[]
  scheduleTimetables        ScheduleTimetable[]
}

model Subject {
  id                      Int                   @id @default(autoincrement())
  name                    String                @unique
  teachers                Teacher[]
  lessons                 Lesson[]
  classTeacherAssignments ClassSubjectTeacher[]
  syllabi                 CourseSyllabus[]
  videoLessons            VideoLesson[]
  timetableEntries        TimetableEntry[]
}

model ClassSubjectTeacher {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model Lesson {
  id          Int          @id @default(autoincrement())
  name        String
  day         Day
  startTime   DateTime
  endTime     DateTime
  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

model Exam {
  id        Int            @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson         @relation(fields: [lessonId], references: [id])
  results   Result[]
  questions ExamQuestion[]
}

model ExamQuestion {
  id           Int                  @id @default(autoincrement())
  examId       Int
  exam         Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionType QuestionType
  questionText String               @db.Text
  points       Int                  @default(10)
  fileUrl      String?
  fileType     String?
  options      ExamQuestionOption[]
  answers      StudentExamAnswer[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ExamQuestionOption {
  id         Int                 @id @default(autoincrement())
  questionId Int
  question   ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String              @db.Text
  isCorrect  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  selectedBy StudentExamAnswer[]
}

model StudentExamAnswer {
  id               Int                 @id @default(autoincrement())
  studentId        String
  student          Student             @relation(fields: [studentId], references: [id])
  questionId       Int
  question         ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText       String?             @db.Text
  selectedOptionId Int?
  selectedOption   ExamQuestionOption? @relation(fields: [selectedOptionId], references: [id])
  isCorrect        Boolean?
  pointsEarned     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([studentId, questionId])
}

model Assignment {
  id        Int                  @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson               @relation(fields: [lessonId], references: [id])
  results   Result[]
  questions AssignmentQuestion[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
}

model AssignmentQuestion {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionType QuestionType
  questionText String           @db.Text
  points       Int              @default(10)
  fileUrl      String?
  fileType     String?
  options      QuestionOption[]
  answers      StudentAnswer[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model QuestionOption {
  id         Int                @id @default(autoincrement())
  questionId Int
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String             @db.Text
  isCorrect  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  selectedBy StudentAnswer[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@unique([examId, studentId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  date        DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Fee {
  id            Int            @id @default(autoincrement())
  title         String
  amount        Float
  paidAmount    Float          @default(0)
  dueDate       DateTime
  status        FeeStatus      @default(PENDING)
  paymentMethod PaymentMethod?
  description   String?        @db.Text
  term          String         @default("")
  academicYear  String         @default("")
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id])
  payments      FeePayment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FeePayment {
  id            Int           @id @default(autoincrement())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  feeId         Int?
  fee           Fee?          @relation(fields: [feeId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  receiptNumber String        @unique
  term          String        @default("")
  academicYear  String        @default("")
  recordedBy    String        @default("admin")
  notes         String?       @db.Text
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  receiptDeliveries ReceiptDelivery[]

  @@index([studentId, paidAt])
  @@index([feeId])
}

enum ReceiptDeliveryChannel {
  SMS
  WHATSAPP
}

enum ReceiptDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model ReceiptDelivery {
  id           Int                   @id @default(autoincrement())
  feePaymentId Int
  feePayment   FeePayment            @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  channel      ReceiptDeliveryChannel
  recipient    String
  message      String                @db.Text
  receiptUrl   String
  status       ReceiptDeliveryStatus @default(PENDING)
  error        String?               @db.Text
  sentAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([feePaymentId])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

model FinanceEntry {
  id             Int              @id @default(autoincrement())
  type           FinanceEntryType
  category       String
  amount         Float
  description    String           @db.Text
  paymentMethod  PaymentMethod    @default(CASH)
  entryDate      DateTime         @default(now())
  recordedById   String
  recordedByName String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([type, entryDate])
  @@index([category])
  @@index([entryDate])
}

model TermBill {
  id           Int            @id @default(autoincrement())
  level        String
  term         String
  academicYear String
  totalAmount  Float          @default(0)
  items        TermBillItem[]
  studentBills StudentBill[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([level, term, academicYear])
}

model TermBillItem {
  id         Int      @id @default(autoincrement())
  termBillId Int
  termBill   TermBill @relation(fields: [termBillId], references: [id], onDelete: Cascade)
  itemName   String
  amount     Float
}

// ─── Student Bills ──────────────────────────────────────────────────────────

model StudentBill {
  id             Int       @id @default(autoincrement())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termBillId     Int?      //* The Prepare Bill template it was generated from
  termBill       TermBill? @relation(fields: [termBillId], references: [id], onDelete: SetNull)
  term           String
  academicYear   String
  //* Snapshot taken when the bill is generated, so a published bill does not
  //* shift under parents when the template, class or ledger changes later.
  studentName    String
  className      String?
  items          Json      //* [{ label, amount }] from the bill template
  totalAmount    Float     @default(0) //* this term's items
  arrears        Float     @default(0) //* unpaid balances from earlier terms
  grandTotal     Float     @default(0)
  billDate       DateTime  @default(now())
  resumptionDate DateTime?
  notes          String?   @db.Text
  //* Null while a draft. Students and parents only see published bills.
  publishedAt    DateTime?
  createdById    String
  createdByName  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, termBillId])
  @@index([termBillId])
  @@index([term, academicYear])
}

model AdmissionBill {
  id        Int      @id @default(autoincrement())
  level     String   @unique
  item      String   @default("Admission Fee & Form")
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExcursionCampaign {
  id            Int                @id @default(autoincrement())
  title         String
  targetAmount  Float
  classId       Int
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById   String
  createdByRole String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      ExcursionPayment[]

  @@index([classId, updatedAt])
}

model ExcursionPayment {
  id             Int               @id @default(autoincrement())
  campaignId     Int
  campaign       ExcursionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Float
  note           String?           @db.Text
  recordedById   String?
  recordedByRole String?
  paidAt         DateTime          @default(now())

  @@index([campaignId, studentId])
  @@index([studentId, paidAt])
}

enum FeeCollectionType {
  PRINTING_FEE
  MOCK_FEE
  SPECIAL_DONATION
}

enum FeeCollectionStatus {
  ACTIVE
  CLOSED
}

model FeeCollectionCampaign {
  id             Int                    @id @default(autoincrement())
  title          String
  collectionType FeeCollectionType
  targetAmount   Float
  status         FeeCollectionStatus    @default(ACTIVE)
  classId        Int
  class          Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById    String
  createdByRole  String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  payments       FeeCollectionPayment[]

  @@index([classId, status, updatedAt])
  @@index([collectionType, status])
}

model FeeCollectionPayment {
  id             Int                   @id @default(autoincrement())
  campaignId     Int
  campaign       FeeCollectionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Float
  note           String?               @db.Text
  recordedById   String?
  recordedByRole String?
  paidAt         DateTime              @default(now())

  @@index([campaignId, studentId])
  @@index([studentId, paidAt])
}

enum PaymentMethod {
  CASH
  MOMO
  ONLINE
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

model Behavior {
  id          Int              @id @default(autoincrement())
  title       String
  description String           @db.Text
  type        BehaviorType
  severity    BehaviorSeverity
  date        DateTime
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  reportedBy  String
  actionTaken String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model MedicalInfo {
  id               Int      @id @default(autoincrement())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id])
  allergies        String?  @db.Text
  medications      String?  @db.Text
  conditions       String?  @db.Text
  immunizations    String?  @db.Text
  bloodType        String?
  emergencyContact String?
  emergencyPhone   String?
  doctorName       String?
  doctorPhone      String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Message {
  id           Int      @id @default(autoincrement())
  subject      String
  content      String   @db.Text
  senderId     String
  senderType   UserType
  receiverId   String
  receiverType UserType
  read         Boolean  @default(false)
  starred      Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserNote {
  id          Int      @id @default(autoincrement())
  userId      String
  userType    UserType
  title       String   @default("My Notes")
  contentHtml String   @db.Text
  contentText String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, userType, updatedAt])
}

enum UserType {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  fileUrl    String
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  category   String
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  authorId   String
  authorName String
  authorRole String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum BehaviorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QuestionType {
  THEORY
  MULTIPLE_CHOICE
}

enum AiWorkspaceRole {
  STUDENT
  TEACHER
}

enum AiConversationKind {
  STUDY_SUPPORT
  TEACHING_SUPPORT
}

enum AiMessageActor {
  USER
  ASSISTANT
  SYSTEM
}

enum AiQuizStatus {
  GENERATED
  COMPLETED
  ABANDONED
}

enum AiQuestionPackSource {
  TOPIC
  PDF
}

model StudentAnswer {
  id               Int                @id @default(autoincrement())
  studentId        String
  student          Student            @relation(fields: [studentId], references: [id])
  questionId       Int
  question         AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText       String?            @db.Text
  selectedOptionId Int?
  selectedOption   QuestionOption?    @relation(fields: [selectedOptionId], references: [id])
  isCorrect        Boolean?
  pointsEarned     Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([studentId, questionId])
}

model AiConversation {
  id            String                  @id @default(uuid())
  userId        String
  userRole      AiWorkspaceRole
  kind          AiConversationKind
  title         String
  summary       String?                 @db.Text
  lessonId      Int?
  subjectId     Int?
  metadata      Json?
  messages      AiConversationMessage[]
  quizAttempts  AiQuizAttempt[]
  questionPacks AiQuestionPack[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId, userRole, updatedAt])
}

model AiConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          AiMessageActor
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AiQuizAttempt {
  id             String          @id @default(uuid())
  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       Int?
  subjectId      Int?
  topic          String
  difficulty     String
  status         AiQuizStatus    @default(GENERATED)
  totalQuestions Int             @default(0)
  correctAnswers Int             @default(0)
  scorePercent   Float           @default(0)
  quizPayload    Json
  answerPayload  Json?
  processLog     Json?
  feedbackText   String?         @db.Text
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([studentId, createdAt])
  @@index([subjectId, createdAt])
}

model AiQuestionPack {
  id                 String               @id @default(uuid())
  conversationId     String?
  conversation       AiConversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  teacherId          String
  teacher            Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessonId           Int?
  subjectId          Int?
  title              String
  topic              String?
  difficulty         String
  questionCount      Int                  @default(0)
  sourceType         AiQuestionPackSource
  sourceName         String?
  sourceMaterialText String?              @db.Text
  packPayload        Json
  notes              String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([teacherId, createdAt])
  @@index([lessonId, createdAt])
}

model SystemSettings {
  id                              Int       @id @default(autoincrement())
  schoolName                      String    @default("Student Management System")
  schoolShortName                 String    @default("SMS")
  schoolLogo                      String?
  schoolStamp                     String?
  primaryColor                    String    @default("#3b82f6")
  secondaryColor                  String    @default("#8b5cf6")
  accentColor                     String    @default("#ec4899")
  schoolEmail                     String?
  schoolPhone                     String?
  schoolAddress                   String?
  schoolWebsite                   String?
