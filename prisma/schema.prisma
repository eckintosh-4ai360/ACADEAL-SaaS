//* ===========================
//* NOTIFICATION SYSTEM MODELS
//* ===========================

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  EXAM
  FEE_REMINDER
  MEETING_REQUEST
  MEETING_REMINDER
  MEETING_CONFIRMATION
  BEHAVIOR
  ATTENDANCE
  GENERAL
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

model Notification {
  id            Int                 @id @default(autoincrement())
  title         String
  message       String              @db.Text
  type          NotificationType
  channel       NotificationChannel @default(IN_APP)
  recipientId   String?
  recipientType UserType?
  classId       Int?
  class         Class?              @relation(fields: [classId], references: [id])
  isRead        Boolean             @default(false)
  sentAt        DateTime            @default(now())
  readAt        DateTime?
  metadata      Json? //* Additional data like assignmentId, feeId, meetingId, etc.
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([recipientId, isRead])
  @@index([classId, isRead])
  @@index([type, sentAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  userType  UserType
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, userType, endpoint])
  @@index([userId, userType])
}

//* ===========================
//* EMAIL TEMPLATE SYSTEM
//* ===========================

enum EmailTemplateCategory {
  WELCOME
  FEE_REMINDER
  ASSIGNMENT_NOTIFICATION
  EXAM_NOTIFICATION
  MEETING_REQUEST
  MEETING_REMINDER
  MEETING_CONFIRMATION
  BEHAVIOR_NOTIFICATION
  ATTENDANCE_ALERT
  GENERAL_ANNOUNCEMENT
  PASSWORD_RESET
  CUSTOM
}

model EmailTemplate {
  id         Int                   @id @default(autoincrement())
  name       String                @unique
  category   EmailTemplateCategory
  subject    String
  bodyHtml   String                @db.Text
  bodyText   String?               @db.Text
  variables  String[]              @default([]) //* List of variable names like {{studentName}}, {{amount}}, etc.
  isActive   Boolean               @default(true)
  isSystem   Boolean               @default(true) //* System templates can't be deleted
  lastUsedAt DateTime?
  usageCount Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  logs       EmailLog[]

  @@index([category, isActive])
}

model EmailLog {
  id           Int            @id @default(autoincrement())
  templateId   Int?
  template     EmailTemplate? @relation(fields: [templateId], references: [id])
  recipient    String
  subject      String
  status       EmailStatus    @default(PENDING)
  sentAt       DateTime?
  errorMessage String?        @db.Text
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([recipient, createdAt])
  @@index([status, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

//* ===========================
//* PARENT-TEACHER MEETING SCHEDULER
//* ===========================

enum MeetingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingType {
  IN_PERSON
  VIRTUAL
  PHONE_CALL
}

model ParentTeacherMeeting {
  id          Int           @id @default(autoincrement())
  title       String
  description String?       @db.Text
  meetingType MeetingType   @default(IN_PERSON)
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  location    String? //* Room number or virtual meeting link
  status      MeetingStatus @default(PENDING)

  //* Participants
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  //* Scheduling
  requestedBy        UserType
  requestedAt        DateTime  @default(now())
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  //* Reminders
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  //* Notes
  teacherNotes     String? @db.Text
  parentNotes      String? @db.Text
  followUpRequired Boolean @default(false)
  followUpNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, date])
  @@index([parentId, date])
  @@index([studentId, date])
  @@index([status, date])
}

model MeetingAvailability {
  id        Int       @id @default(autoincrement())
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  dayOfWeek Int //* 0-6 (Sunday-Saturday)
  startTime String //* "09:00"
  endTime   String //* "17:00"
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([teacherId, isActive])
}

model MeetingBlackout {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startTime, endTime])
}

//* ===========================
//* HR MODULE MODELS
//* ===========================

// ─── Payroll ────────────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id           Int            @id @default(autoincrement())
  period       String         //* e.g. "2025-01" (YYYY-MM) or "2025 Term 1"
  periodType   String         @default("MONTHLY") //* MONTHLY | TERM
  status       PayrollStatus  @default(DRAFT)
  totalGross   Float          @default(0)
  totalNet     Float          @default(0)
  currency     String         @default("GHS")
  notes        String?        @db.Text
  createdById  String
  createdByName String
  approvedById String?
  approvedByName String?
  approvedAt   DateTime?
  paidAt       DateTime?
  entries      PayrollEntry[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([period])
}

model PayrollEntry {
  id             Int        @id @default(autoincrement())
  runId          Int
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffId        String     //* References Staff.id or Teacher.id or Admin.id
  staffName      String
  staffType      String     //* "ADMIN" | "TEACHER"
  staffProfileId String?    //* Unified Staff.staffId for display
  grossSalary    Float
  taxDeduction   Float      @default(0)
  ssnitDeduction Float      @default(0)
  otherDeductions Float     @default(0)
  netSalary      Float
  notes          String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([runId, staffId])
  @@index([runId])
  @@index([staffId])
}

// ─── Payslips ───────────────────────────────────────────────────────────────

model Payslip {
  id              Int      @id @default(autoincrement())
  staffId         String   //* References Staff.id or Teacher.id or Admin.id (same as PayrollEntry)
  staffType       String   //* "ADMIN" | "TEACHER"
  salaryMonth     String   //* "YYYY-MM"
  //* Employee details are a snapshot: editable per payslip, so a reprint
  //* always shows what was issued even after the staff profile changes.
  employeeId      String?
  title           String?
  fullName        String
  designation     String?
  gradeLevel      String?
  phone           String?
  email           String?
  bankName        String?
  accountNumber   String?
  bankBranch      String?
  ssnitNumber     String?
  ssnitBranch     String?
  //* Line items are [{ label, amount }] so schools can rename, add or drop rows.
  earnings        Json
  otherClaims     Json
  deductions      Json
  otherDeductions Json
  grossSalary     Float    @default(0) //* earnings only
  totalGross      Float    @default(0) //* earnings + other claims
  totalDeductions Float    @default(0)
  netSalary       Float    @default(0)
  preparedBy      String?
  footerNote      String?  @db.Text
  //* Null while a draft. Teachers only see published payslips in My Payslips.
  publishedAt     DateTime?
  createdById     String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, salaryMonth])
  @@index([salaryMonth])
}

// ─── Leave ──────────────────────────────────────────────────────────────────

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id             Int         @id @default(autoincrement())
  staffId        String      //* References Staff.id (unified) or Teacher/Admin.id
  staffName      String
  staffType      String      //* "ADMIN" | "TEACHER"
  staffProfileId String?     //* Staff.staffId for display
  leaveType      LeaveType
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String      @db.Text
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewNote     String?     @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([staffId, createdAt])
  @@index([status, startDate])
  @@index([leaveType, status])
}

// ─── Appraisals ─────────────────────────────────────────────────────────────

enum AppraisalCycleStatus {
  OPEN
  CLOSED
}

enum AppraisalRecommendation {
  PROMOTE
  RETAIN
  IMPROVE
  DISMISS
}

model AppraisalCycle {
  id          Int                  @id @default(autoincrement())
  title       String
  period      String               //* e.g. "2025 Term 1"
  startDate   DateTime
  endDate     DateTime
  status      AppraisalCycleStatus @default(OPEN)
  description String?              @db.Text
  createdById String
  createdByName String
  closedAt    DateTime?
  records     AppraisalRecord[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, startDate])
}

model AppraisalRecord {
  id               Int                     @id @default(autoincrement())
  cycleId          Int
  cycle            AppraisalCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  staffId          String
  staffName        String
  staffType        String
  staffProfileId   String?
  score            Int                     //* 1–5
  teachingScore    Int?                    //* For teachers: specific teaching dimension
  professionalScore Int?
  conductScore     Int?
  comments         String?                 @db.Text
  strengths        String?                 @db.Text
  improvements     String?                 @db.Text
  recommendation   AppraisalRecommendation @default(RETAIN)
  reviewerId       String
  reviewerName     String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([cycleId, staffId])
  @@index([cycleId])
  @@index([staffId])
  @@index([recommendation])
}

model TimetablePeriod {
  id        Int              @id @default(autoincrement())
  name      String           //* e.g. "Period 1", "Break", "Period 3"
  startTime String           //* e.g. "07:30"
  endTime   String           //* e.g. "08:10"
  order     Int              @default(1)
  isBreak   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   TimetableEntry[]
}

model ScheduleTimetable {
  id           Int              @id @default(autoincrement())
  classId      Int
  class        Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  term         String           //* e.g. "Term 1", "Term 2", "Term 3"
  academicYear String           //* e.g. "2024-2025"
  isPublished  Boolean          @default(false)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  entries      TimetableEntry[]

  @@unique([classId, term, academicYear])
}

model TimetableEntry {
  id          Int               @id @default(autoincrement())
  timetableId Int
  timetable   ScheduleTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  periodId    Int
  period      TimetablePeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  day         Day               //* MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
  subjectId   Int?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  note        String?           //* e.g. "Assembly", "Sports"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([timetableId, periodId, day])
}

model ClassMigrationSnapshot {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  migrationType  String    // "TOTAL" | "INDIVIDUAL"
  description    String
  studentCount   Int       @default(0)
  graduatedCount Int       @default(0)
  revertedAt     DateTime?
  revertedBy     String?
  snapshotData   Json

  @@index([createdAt(sort: Desc)])
  @@index([revertedAt])
}


